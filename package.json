{
  "name": "beauty-supply-pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:electron\"",
    "dev:main": "tsup src/main/main.ts --format cjs --out-dir dist/main --target node18 --watch --external electron,electron-updater",
    "dev:preload": "tsup src/preload/preload.ts --format cjs --out-dir dist/preload --target node18 --watch --external electron",
    "dev:renderer": "vite",
    "electron": "wait-on tcp:5173 && electron .",
    "build": "tsup src/main/main.ts --format cjs --out-dir dist/main --target node18 --external electron,electron-updater && tsup src/preload/preload.ts --format cjs --out-dir dist/preload --target node18 --external electron && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --win",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node ./scripts/migrate.mjs",
    "seed:admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/seed-admin.mjs",
    "db:precheck": "node ./scripts/precheck-integrity.mjs",
    "test:unit": "node --experimental-strip-types --test \"e2e/unit/*.test.mjs\"",
    "test:security": "node e2e/run.mjs security",
    "test:e2e": "node e2e/run.mjs ui",
    "test:integration": "node e2e/run.mjs integration",
    "test:catalog": "node e2e/run.mjs catalog",
    "test:returns": "node e2e/run.mjs returns",
    "test:hardening": "node e2e/run.mjs hardening",
    "test:pin": "node e2e/run.mjs pin",
    "test:screens": "node e2e/run.mjs screens",
    "test:migrations": "node e2e/migrations.mjs",
    "test:all": "npm run test:unit && node e2e/run.mjs all && node e2e/migrations.mjs",
    "package:dir": "npm run build && electron-builder --win dir",
    "test:packaged": "node e2e/packaged.mjs"
  },
  "build": {
    "appId": "com.beauty.pos",
    "productName": "Beauty POS",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "drizzle/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.0",
    "electron-updater": "^6.1.8",
    "embla-carousel-react": "^8.5.1",
    "input-otp": "^1.4.1",
    "lucide-react": "^0.454.0",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.7",
    "electron": "^39.2.5",
    "electron-builder": "^24.13.3",
    "eslint": "^9.12.0",
    "globals": "^14.0.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vite": "^7.2.6",
    "wait-on": "^7.2.0"
  }
}
